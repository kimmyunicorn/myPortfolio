# Copy to .env.local for development. These values are PUBLIC (they ship to the browser).
# Never put Cloudflare R2 access keys or Supabase service keys in any VITE_ variable.

# Public URL of your R2 bucket (custom domain recommended). Leave empty to use /public/media.
VITE_ASSET_BASE_URL=

# "/" for kimberlycamanero.github.io, "/<repo>/" for a project site.
VITE_BASE=/
